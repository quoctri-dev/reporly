# ═══════════════════════════════════════════════════
# Reporly — Environment Configuration
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════

# ── REQUIRED ──────────────────────────────────────
# LLM API key (needed for AI analysis)
# Get from: https://aistudio.google.com/apikey (Gemini)
#        or https://console.anthropic.com (Claude)
#        or https://console.groq.com (Groq — free)
LLM_API_KEY=your_api_key_here

# ── SWAPPABLE ─────────────────────────────────────
# LLM model (swap provider by changing this line)
# Options: gemini/gemini-2.0-flash (default, rẻ nhất)
#          claude-sonnet-4-6 (requires Anthropic key)
#          groq/llama-3.1-70b-versatile (requires Groq key)
LLM_MODEL=gemini/gemini-2.0-flash

# LLM parameters
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000

# ── OPTIONAL ──────────────────────────────────────
# Data limits
MAX_FILE_SIZE_MB=10
MAX_ROWS=100000
MAX_COLUMNS=50
MAX_INSIGHTS=5

# Report
REPORT_TITLE=Data Analysis Report
MAX_CHARTS=5

# Debug mode (set to true for verbose logging)
DEBUG=false
